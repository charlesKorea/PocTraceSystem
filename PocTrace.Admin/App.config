<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
  <appSettings>
    <add key="SharedCachePath" value="X:\jHOOK\PocTraceData" />
    <add key="DailyReportPath" value="X:\jHOOK\DailyReport" />
    <add key="AllowDatabaseFallback" value="true" />
    <add key="EnableDetailedDebug" value="false" />
    <add key="ExcelPerformanceCompareEnabled" value="false" />
    <add key="ExcelPerformanceCompareRowThreshold" value="50000" />
    <add key="ExcelUseLargeXlsxForFullList" value="true" />
    <add key="ExcelLargeExportRowThreshold" value="50000" />
    <add key="AdminBuildReverseGraphIndex" value="false" />
    <add key="AdminGcBetweenDatabases" value="true" />
    <add key="AdminContinueOnDbFailure" value="true" />
    <add key="CacheStaleHours" value="24" />
    <add key="CacheMaxAgeHours" value="48" />
    <add key="CacheKeepGenerations" value="2" />
    <add key="MaxParallelTrace" value="4" />
    <add key="DesignProgressEnabled" value="true" />
    <add key="DesignProgressInProgressDays" value="2" />
    <add key="DesignProgressIdleStableDays" value="14" />
    <add key="DesignProgressMinCohortSize" value="3" />
    <add key="DesignProgressLengthWeight" value="0.6" />
    <add key="FrmConnectionString" value="" />
    <!-- 비운다. DB 비밀번호는 실행 폴더의 config\db.secret. 실행 폴더 밖 경로는 무시된다. -->
    <add key="SecretConfigDirectory" value="" />
    <add key="FrmEquipmentView" value="dbo.V_FRM_EquipmentProgress" />
    <!-- SchemaKind: S5d | TbStar | WebDdw. 기본 S5d.
         DDW로 바꾸기 전에 Viewer/Web/Demolition/NozzleTrace가 v10 캐시를 읽는 빌드여야 한다.
         그 다음 Admin SaveToCache(v10) 후 SchemaKind를 TbStar 또는 WebDdw로 바꾼다. -->
    <add key="SchemaKind" value="S5d" />
    <!-- 운영: x1,x2,x2_2 / 향후 x2_m 추가 가능. Admin은 갱신 대상만 나열해도 됨 -->
    <add key="TargetDatabases" value="x1" />
  </appSettings>
  <connectionStrings>
    <!-- 비밀번호는 config\db.secret. 처음 한 번은 여기에 넣고 실행하면 암호 파일로 옮긴 뒤 이 값을 지운다. -->
  </connectionStrings>
</configuration>
