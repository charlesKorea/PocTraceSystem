<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="SchemaKind" value="S5d" />
    <add key="TargetDatabases" value="x1,x2,x2_2" />
    <add key="AllowDatabaseFallback" value="false" />
    <!-- 비우면 C:\ProgramData\PocTrace\config (숨김). DB 비밀번호는 그 폴더의 secrets.config -->
    <add key="SecretConfigDirectory" value="" />
  </appSettings>
  <connectionStrings>
    <!-- 계정은 exe.config에 두지 않는다. secrets.config 의 SourceDb 를 읽는다. -->
  </connectionStrings>
</configuration>
