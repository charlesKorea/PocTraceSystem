<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="SchemaKind" value="S5d" />
    <add key="TargetDatabases" value="x1,x2,x2_2" />
    <add key="AllowDatabaseFallback" value="false" />
    <!-- 비운다. DB 비밀번호는 실행 폴더의 config\db.secret. 실행 폴더 밖 경로는 무시된다. -->
    <add key="SecretConfigDirectory" value="" />
  </appSettings>
  <connectionStrings>
    <!-- 비밀번호는 config\db.secret. 처음 한 번은 여기에 넣고 실행하면 암호 파일로 옮긴 뒤 이 값을 지운다. -->
  </connectionStrings>
</configuration>
