<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="SchemaKind" value="S5d" />
    <add key="TargetDatabases" value="x1,x2,x2_2" />
    <add key="AllowDatabaseFallback" value="false" />
  </appSettings>
  <connectionStrings>
    <!-- Database=master. 쿼리는 TargetDatabases 이름(x1 등)을 붙인다. -->
    <add name="SourceDb"
         connectionString="Server=YOUR_SERVER_IP;Database=master;User Id=YOUR_ID;Password=YOUR_PW;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
