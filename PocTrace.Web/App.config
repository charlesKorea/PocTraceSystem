<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
  <appSettings>
    <!-- Viewer와 같은 공유 캐시. 이 프로그램은 읽기만 한다. -->
    <add key="SharedCachePath" value="X:\jHOOK\PocTraceData" />
    <add key="DailyReportPath" value="X:\jHOOK\DailyReport" />
    <add key="AllowDatabaseFallback" value="false" />
    <add key="EnableDetailedDebug" value="false" />
    <add key="CacheStaleHours" value="24" />
    <add key="CacheMaxAgeHours" value="48" />
    <add key="MaxParallelTrace" value="2" />
    <add key="TargetDatabases" value="x1,x2,x2_2" />
    <!-- 모든 사용자의 검수 기록을 모으는 공용 폴더. 이 아래 PocTraceWebHistory 폴더에 사용자·월별 jsonl 로 쌓는다. 쓸 수 없으면 개인 로컬 기록만 남는다. -->
    <add key="SharedHistoryPath" value="Y:\sds\999. data" />
    <!-- 상단 "예상 메모리" = 캐시 폴더 크기 x 배수 + 300MB. 실제 memory-load.log 와 비교해 조정한다. -->
    <add key="MemoryEstimateFactor" value="3.0" />
    <!-- 이 PC의 현재 사용자만. SVDI 세션마다 exe를 따로 실행한다. -->
    <add key="ListenHost" value="127.0.0.1" />
    <add key="ListenPort" value="5088" />
    <add key="OpenBrowser" value="true" />
  </appSettings>
</configuration>
