<?xml version="1.0" encoding="utf-8"?>
<!--
  PC 공통 오프라인 NuGet 소스.
  모든 C# 솔루션에 이 파일을 솔루션 루트에 두거나,
  %AppData%\NuGet\NuGet.Config 에 동일 source를 추가하세요.
-->
<configuration>
  <packageSources>
    <clear />
    <!-- 1순위: PC 공통 오프라인 폴더 -->
    <add key="OfflineDev" value="C:\OfflineDev\nuget-packages" />
    <!-- 온라인 개발 PC에서만 사용. 에어갭 PC에서는 아래 줄을 주석 처리하거나 clear 후 OfflineDev만 남김 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <!-- restore 결과가 공용 폴더에 쌓이도록 (선택) -->
    <add key="globalPackagesFolder" value="C:\OfflineDev\nuget-packages" />
  </config>
</configuration>
