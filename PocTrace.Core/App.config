<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="SharedCachePath" value="X:\jHOOK\PocTraceData" />
    <add key="DailyReportPath" value="X:\jHOOK\DailyReport" />
    <add key="AllowDatabaseFallback" value="false" />
    <add key="EnableDetailedDebug" value="false" />
    <add key="CacheStaleHours" value="24" />
    <add key="CacheMaxAgeHours" value="48" />
    <add key="MaxParallelTrace" value="4" />
    <add key="DesignProgressEnabled" value="true" />
    <add key="DesignProgressInProgressDays" value="2" />
    <add key="DesignProgressIdleStableDays" value="14" />
    <add key="DesignProgressMinCohortSize" value="3" />
    <add key="DesignProgressLengthWeight" value="0.6" />
    <add key="FrmConnectionString" value="" />
    <add key="FrmEquipmentView" value="dbo.V_FRM_EquipmentProgress" />
    <!-- SchemaKind: S5d | TbStar | WebDdw. 명시 값만 사용. 쿼리 실패로 다른 프로파일을 고르지 않는다.
         TbStar = TB_* 원천. WebDdw = tag, s5_eqcode, construction_code, elementId_number,
         Subdivision_1_name, Subdivision_2_name, poc tag, connectionTag 가 있는 적재본.
         기본 S5d. v10 캐시는 v9와 v10을 모두 읽는 쪽을 배포한 뒤 Admin이 발행한다. -->
    <add key="SchemaKind" value="S5d" />
    <add key="TargetDatabases" value="x1" />
    <add key="ExcelUseLargeXlsxForFullList" value="true" />
    <add key="ExcelLargeExportRowThreshold" value="50000" />
  </appSettings>
  <connectionStrings>
    <add name="SourceDb"
         connectionString="Server=localhost;Database=DummyDB;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
    <add name="LocalDb"
         connectionString="Data Source=Cache.db;Version=3;"
         providerName="System.Data.SQLite" />
  </connectionStrings>
</configuration>
