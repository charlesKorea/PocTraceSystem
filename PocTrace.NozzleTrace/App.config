<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
  <appSettings>
    <add key="SharedCachePath" value="X:\jHOOK\PocTraceData" />
    <add key="DailyReportPath" value="X:\jHOOK\DailyReport" />
    <!-- 클라이언트는 공유 캐시만 읽는다. true면 사용자 PC가 DB에서 읽어 공용 캐시를 덮어쓸 수 있다. -->
    <add key="AllowDatabaseFallback" value="false" />
    <add key="EnableDetailedDebug" value="false" />
    <add key="CacheStaleHours" value="24" />
    <add key="CacheMaxAgeHours" value="48" />
    <add key="MaxParallelTrace" value="4" />
    <add key="TargetDatabases" value="x1" />
  </appSettings>
  <connectionStrings>
    <add name="SourceDb"
         connectionString="Server=YOUR_SERVER_IP;Database=master;User Id=YOUR_ID;Password=YOUR_PW;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
