<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- 64비트에서 2GB보다 큰 배열을 허용. 32비트 프로세스에는 효과가 없다. -->
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
  <appSettings>
    <add key="IsTestMode" value="false" />
    <add key="SharedCachePath" value="X:\jHOOK\PocTraceData" />
    <add key="DailyReportPath" value="X:\jHOOK\DailyReport" />
    <!-- 캐시 파일이 없을 때만 SQL. Initializing Graph 와는 무관하고, true면 실패 시 메모리를 더 쓴다. -->
    <add key="AllowDatabaseFallback" value="false" />
    <add key="EnableDetailedDebug" value="false" />
    <add key="CacheStaleHours" value="24" />
    <add key="CacheMaxAgeHours" value="48" />
    <add key="MaxParallelTrace" value="2" />
    <add key="DesignProgressEnabled" value="true" />
    <add key="DesignProgressInProgressDays" value="2" />
    <add key="DesignProgressIdleStableDays" value="14" />
    <add key="DesignProgressMinCohortSize" value="3" />
    <add key="DesignProgressLengthWeight" value="0.6" />
    <add key="FrmConnectionString" value="" />
    <add key="FrmEquipmentView" value="dbo.V_FRM_EquipmentProgress" />
    <!-- x2_m 추가 시: value="x1,x2,x2_2,x2_m" (DB당 GraphCache_{name}/ 폴더 자동) -->
    <add key="TargetDatabases" value="x1,x2,x2_2" />
  </appSettings>
  <connectionStrings>
    <add name="SourceDb"
         connectionString="Server=localhost;Database=DummyDB;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
    <add name="LocalDb"
         connectionString="Data Source=LocalCache.db;Version=3;"
         providerName="System.Data.SQLite" />
  </connectionStrings>
</configuration>
